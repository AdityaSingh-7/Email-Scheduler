# Backend Environment Variables Template
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox_scheduler?schema=public"

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ & Rate Limiter Configuration
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200

# Ethereal Fake SMTP Credentials (Optional - auto-generated if empty)
ETHEREAL_USER=
ETHEREAL_PASS=
